        CAM["Flutter camera upload<br/>lab_upload_screen.dart"]
        WEB["React record browser<br/>RecordsPage.tsx"]
    end

    subgraph API["ASP.NET Core — S2"]
        RC["RecordsController<br/>multipart + extract + review"]
