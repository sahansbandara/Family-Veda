        HF["hereditary_flags<br/>manually_confirmed = false"]
        AUDIT["audit_logs<br/>LAB_REPORT_MANUAL_REVIEW"]
        CONFIRMED["confirmed flags only"]
    end

    S4["Familial Risk Agent S4<br/>read_consented_hereditary_flags"]

    CAM --> RC
    WEB --> RC
    RC --> RS --> LR
    RC -->|POST /extract| EA
